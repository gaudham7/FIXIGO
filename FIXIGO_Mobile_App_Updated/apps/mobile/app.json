{
  "expo": {
    "name": "FIXIGO",
    "slug": "fixigo",
    "scheme": "fixigo",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.fixigo.app"
    },
    "ios": {
      "bundleIdentifier": "com.fixigo.app"
    }
  }
}
